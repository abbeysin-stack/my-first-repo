{
  "name": "division-attendance",
  "version": "0.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "start": "npm run build && node --use-env-proxy server.js",
    "serve": "node --use-env-proxy server.js",
    "dev": "vite --host 127.0.0.1",
    "build": "tsc --noEmit && vite build",
    "lint": "tsc --noEmit",
    "test": "node --test",
    "format": "prettier --write web server.js platform.js microsoft.js src test scripts",
    "test:browser": "npm run build && node scripts/review-browser.mjs && node scripts/live-browser.mjs"
  },
  "dependencies": {
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "lucide-react": "0.468.0",
    "html2canvas": "1.4.1",
    "fflate": "0.8.3"
  },
  "devDependencies": {
    "typescript": "5.8.3",
    "vite": "8.3.5",
    "@vitejs/plugin-react": "6.1.2",
    "@types/react": "18.3.18",
    "@types/react-dom": "18.3.5",
    "tailwindcss": "4.3.3",
    "postcss": "8.5.32",
    "@tailwindcss/postcss": "4.3.3",
    "prettier": "3.5.3",
    "playwright": "1.64.1"
  }
}
